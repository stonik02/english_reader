APP_ENV=development
GRPC_ADDR=:9090
HTTP_ADDR=:8081
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_PORT=5433
ENVOY_PORT=8082
API_HTTP_PORT=8083
DATABASE_URL=postgres://reader:reader@localhost:5433/reader?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SHUTDOWN_TIMEOUT=10s
BOOK_STORAGE_PATH=/var/lib/english-reader/books
TRANSLATE_URL=http://localhost:5000
TRANSLATE_TIMEOUT=2s
TRANSLATE_CACHE_TTL=168h
LOOKUP_WORD_MAX_LENGTH=96
LOOKUP_SENTENCE_MAX_LENGTH=360
